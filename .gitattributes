VEIP-MCP/EXECUTION/VEIP-CORE-v0.1.0-REFREEZE-004/inputs/VEIP_CORE_SCHEMA_v0.1.json -text
VEIP-MCP/EXECUTION/VEIP-CORE-v0.1.0-REFREEZE-004/inputs/VEIP_REASON_CODE_REGISTRY_v0.1.json -text
VEIP-MCP/EXECUTION/VEIP-CORE-v0.1.0-REFREEZE-004/veip-core/src/veip_core/data/VEIP_CORE_SCHEMA_v0.1.json -text
