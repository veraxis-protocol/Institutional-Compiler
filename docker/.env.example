# Development-only environment for docker/compose.yaml.
#
#   cp docker/.env.example docker/.env
#
# `.env` is git-ignored and must never be committed. These values are for a loopback-only
# local development stack and are NOT suitable for any shared, staging, or production
# environment. Every service published by compose.yaml binds to 127.0.0.1 only.
#
# Replace every CHANGEME below before starting the stack. The compose file fails fast
# with a clear message if any required variable is unset, so there is no silent default
# credential.

# --- PostgreSQL ---
POSTGRES_USER=oic_dev
POSTGRES_PASSWORD=CHANGEME_local_dev_only
POSTGRES_DB=oic_dev
POSTGRES_PORT=5432

# --- MinIO ---
# MinIO requires a root password of at least 8 characters.
MINIO_ROOT_USER=oic_dev
MINIO_ROOT_PASSWORD=CHANGEME_local_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- OPA ---
OPA_PORT=8181
OPA_DIAGNOSTIC_PORT=8282
