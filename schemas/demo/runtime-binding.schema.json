{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openinstitutionalcompiler.org/schemas/demo/runtime-binding.schema.json",
  "title": "DemoRuntimeBinding",
  "$comment": "DEMONSTRATION LANE ONLY. A runtime projection that binds the versions one evaluation ran against. It is NOT an extension of OpenControlEnvelope: the governing envelope schema is unchanged, and canonical institutional meaning remains in the InstitutionalIR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "schema_version",
    "envelope_id",
    "envelope_hash",
    "control_id",
    "control_version",
    "source_version_set",
    "source_version_set_hash",
    "admission_version",
    "authority_version",
    "kernel_profile_id",
    "canonicalization_profile_id",
    "bound_formula_hash",
    "warrant_requirement"
  ],
  "properties": {
    "binding_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string" },
    "envelope_id": { "type": "string", "minLength": 1 },
    "envelope_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "control_id": { "type": "string", "minLength": 1 },
    "control_version": { "type": "string", "minLength": 1 },
    "source_version_set": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "source_version_set_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "admission_version": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "authority_version": { "type": "string", "minLength": 1 },
    "kernel_profile_id": { "type": "string", "minLength": 1 },
    "canonicalization_profile_id": { "type": "string", "minLength": 1 },
    "bound_formula_hash": { "type": "string", "pattern": "^sha384:[0-9a-f]{96}$" },
    "warrant_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "kernel_profile_id", "minimum_warranty_grade", "on_insufficient_grade", "unverified_ground_policy"],
      "properties": {
        "mode": { "enum": ["required", "not_required", "not_applicable"] },
        "kernel_profile_id": { "type": ["string", "null"] },
        "minimum_warranty_grade": { "enum": ["hereditary", "sound", "until-verification", null] },
        "on_insufficient_grade": { "enum": ["block", "escalate", null] },
        "unverified_ground_policy": { "enum": ["forbid", "escalate", "allow_with_disclosure", null] }
      }
    },
    "projection_note": { "type": "string" }
  }
}
