{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openinstitutionalcompiler.org/schemas/demo/oam-decision.schema.json",
  "title": "DemoOAMDecision",
  "$comment": "DEMONSTRATION LANE ONLY. Four questions are kept in four fields on purpose: what the logic kernel concluded, whether the institution authorizes the act, what the runtime does, and why. None of them may be derived from another, and an authority or currentness refusal must never rewrite epistemic_status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_class",
    "schema_version",
    "decision_id",
    "case_id",
    "scenario_id",
    "execution_context",
    "evaluated_at",
    "epistemic_status",
    "institutional_authorization_status",
    "execution_disposition",
    "decision_basis",
    "ztl_observation",
    "currentness_observation",
    "authority_observation",
    "unmet_components",
    "bounded_action",
    "runtime_binding_id",
    "claim_ceiling",
    "measured_end_to_end_claim"
  ],
  "properties": {
    "record_class": { "const": "OIC_DEMO_OAM_DECISION" },
    "schema_version": { "type": "string" },
    "decision_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "execution_context": { "enum": ["DEVELOPMENT_TEST_ONLY", "OWNER_AUTHORIZED_RESULT_BEARING"] },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "epistemic_status": { "enum": ["ESTABLISHED", "CONDITIONALLY_SUPPORTED", "UNRESOLVED", "REFUTED"] },
    "institutional_authorization_status": { "enum": ["AUTHORIZED", "REFUSED", "UNRESOLVED"] },
    "execution_disposition": { "enum": ["ALLOW", "BLOCK", "ESCALATE"] },
    "decision_basis": { "enum": ["SUBSTANTIVE", "PRECAUTIONARY", "PROCEDURAL", "CONTROL_REQUIREMENT"] },
    "ztl_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "warranty_grade", "raw_verdict", "raw_verdict_is_operationally_inert", "unverified_ground_ids", "kernel_profile_id", "warrant_artifact_id"],
      "properties": {
        "disposition": { "enum": ["EARNED", "REFUTED", "ON CREDIT", "OPEN"] },
        "warranty_grade": { "enum": ["hereditary", "sound", "until-verification"] },
        "raw_verdict": { "enum": ["T", "F", "Z"] },
        "raw_verdict_is_operationally_inert": { "const": true },
        "unverified_ground_ids": { "type": "array", "items": { "type": "string" } },
        "kernel_profile_id": { "type": "string" },
        "warrant_artifact_id": { "type": "string" }
      }
    },
    "currentness_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_code_id", "reason_code", "decision", "resolution_digest"],
      "properties": {
        "state": { "enum": ["CURRENT", "SUPERSEDED", "INELIGIBLE", "UNKNOWN"] },
        "reason_code_id": { "type": "string" },
        "reason_code": { "type": "string" },
        "decision": { "enum": ["PROCEED", "DENY"] },
        "resolution_digest": { "type": "string" }
      }
    },
    "authority_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason_code_id", "reason_code", "authority_decision_digest"],
      "properties": {
        "decision": { "enum": ["PROCEED", "DENY", "ESCALATE"] },
        "reason_code_id": { "type": "string" },
        "reason_code": { "type": "string" },
        "authority_decision_digest": { "type": "string" }
      }
    },
    "unmet_components": { "type": "array", "items": { "type": "string" } },
    "bounded_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "action_state", "gate_class", "performs_real_world_effect"],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 1 },
        "action_state": { "enum": ["ACTION_PERMITTED", "ACTION_BLOCKED", "ACTION_ESCALATED"] },
        "gate_class": { "const": "BOUNDED_DEMO_EXECUTION_GATE" },
        "performs_real_world_effect": { "const": false }
      }
    },
    "runtime_binding_id": { "type": "string", "minLength": 1 },
    "claim_ceiling": { "const": "SYNTHETIC_END_TO_END_PIPELINE_IMPLEMENTED_AND_TESTED" },
    "measured_end_to_end_claim": { "const": false }
  }
}
