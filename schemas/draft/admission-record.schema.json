{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openinstitutionalcompiler.org/schemas/draft/admission-record.schema.json",
  "title": "AdmissionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_id",
    "subject_id",
    "disposition",
    "reviewer",
    "reviewer_role",
    "authority_basis",
    "scope",
    "recorded_at",
    "source_hashes"
  ],
  "properties": {
    "admission_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "admit",
        "admit_with_qualification",
        "modify_and_admit",
        "reject",
        "escalate",
        "non_automatable"
      ]
    },
    "reviewer": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string"
    },
    "authority_basis": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}